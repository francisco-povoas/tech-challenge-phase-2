## ============================================================
## IDs — OS principal (fluxo feliz)
## ============================================================

@clienteId = 932bce16-8f21-47bf-8502-aeccb1445cdc
@veiculoId = f08195db-2b32-40bc-8dda-969e05f4f9ac
@servicoId = 6b45df4f-1a0d-44db-a06b-6a6489150810
@itemEstoqueId = 8b0772cc-fbb1-4991-82d3-43e8c19865fd
@ordemServicoId = c5f4b65b-4ee8-4e96-93a3-bdd3c802234f
