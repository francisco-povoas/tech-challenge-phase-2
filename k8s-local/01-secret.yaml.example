# Copie este arquivo para 01-secret.yaml, substitua todos os valores de exemplo
# e aplique-o antes dos demais recursos.
apiVersion: v1
kind: Secret
metadata:
  name: mvp-oficina-api-secrets
  namespace: local
type: Opaque
stringData:
  ENV: "dev"
  LOG_LEVEL: "DEBUG"
  DB_URL: "postgresql+asyncpg://oficina_user:SUBSTITUA_A_SENHA@mvp-oficina-postgres:5432/oficina_local"
  POSTGRES_USER: "oficina_user"
  POSTGRES_PASSWORD: "SUBSTITUA_A_SENHA"
  POSTGRES_DB: "oficina_local"
  JWT_SECRET_KEY: "SUBSTITUA_POR_UMA_CHAVE_LOCAL_ALEATORIA"
  ADMIN_NOME: "Administrador"
  ADMIN_EMAIL: "admin@example.com"
  ADMIN_PASSWORD: "SUBSTITUA_A_SENHA_DO_ADMIN"
