# Copie para .env.dev, .env.test ou .env.prod conforme o contexto.

ENV=dev
LOG_LEVEL=INFO
DB_URL=postgresql+asyncpg://postgres:postgres@db:5432/app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_dev
JWT_SECRET_KEY=change-me
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=false
APP_DEBUG=false
