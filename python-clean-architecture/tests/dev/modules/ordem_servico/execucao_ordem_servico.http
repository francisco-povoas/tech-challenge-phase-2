    "cpf_cnpj": "65847180076",
    "telefone": "11988880004",
    "email": "roberto.exec.c4@example.com",
    "cep": "01310100",
    "logradouro": "Rua da Consolacao",
    "numero": "400",
    "complemento": null,
    "bairro": "Consolacao",
    "cidade": "Sao Paulo",
    "uf": "SP"
}

###

